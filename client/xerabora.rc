// Windows resources: the icon and the file properties Explorer shows.
1 ICON "xerabora.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,4
PRODUCTVERSION 0,1,0,4
FILEFLAGSMASK 0x3fL
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "xeRAbora"
      VALUE "ProductVersion", "0.1.0-alpha.4"
      VALUE "FileVersion", "0.1.0-alpha.4"
      VALUE "FileDescription", "xeRAbora: RetroAchievements on a real PlayStation 2"
      VALUE "OriginalFilename", "xerabora.exe"
      VALUE "LegalCopyright", "MIT license"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
